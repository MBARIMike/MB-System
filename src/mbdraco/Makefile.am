# Draco compression of triangle meshes, shared by mbgrd2gltf, mbmesh and mbglb2tiles: the Draco encoder and decoder source in draco/
# (the files the CMake build compiles, without the tests) and draco_mesh.cpp, which chooses the quantization of a mesh and writes the
# KHR_draco_mesh_compression primitive of a glTF. It is a convenience library that the programs link.
noinst_LTLIBRARIES = libmbdraco.la

AM_CPPFLAGS =
AM_CPPFLAGS += -I$(top_srcdir)/src/mbdraco
# tinygltf is held beside the glTF writers of mbgrd2gltf.
AM_CPPFLAGS += -I$(top_srcdir)/src/mbgrd2gltf

# The vendored Draco source is not ours to make quiet.
libmbdraco_la_CXXFLAGS = -std=c++17 -w -DMBDRACO_WITH_DRACO
